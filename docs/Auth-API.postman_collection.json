{
  "info": {
    "name": "Secure Auth System API",
    "description": "Authentication endpoints for the Week 2 Task 3 project.\n\nRun the collection in order with the Collection Runner. The pre-request script on **Register** creates a unique email and username for each run. Postman keeps the `auth_token` HttpOnly cookie automatically, so later requests are authenticated without copying any token.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000/api"
    },
    {
      "key": "email",
      "value": ""
    },
    {
      "key": "username",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "Health",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/health",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "health"
          ]
        },
        "description": ""
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status is 200\", () => pm.response.to.have.status(200));"
            ]
          }
        }
      ]
    },
    {
      "name": "Protected route without login \u2192 401",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/auth/me",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "auth",
            "me"
          ]
        },
        "description": ""
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status is 401\", () => pm.response.to.have.status(401));"
            ]
          }
        }
      ]
    },
    {
      "name": "Register \u2014 validation errors",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/auth/register",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "auth",
            "register"
          ]
        },
        "description": "",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"bad-email\",\n  \"username\": \"x\",\n  \"password\": \"short\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status is 400\", () => pm.response.to.have.status(400));",
              "pm.test(\"Field errors\", () => pm.expect(pm.response.json().error.details.map(d => d.field)).to.include.members([\"email\", \"username\", \"password\"]));"
            ]
          }
        }
      ]
    },
    {
      "name": "Register",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/auth/register",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "auth",
            "register"
          ]
        },
        "description": "Creates the account and logs in (sets the `auth_token` cookie).",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"{{email}}\",\n  \"username\": \"{{username}}\",\n  \"password\": \"Postman-Pass-2026\",\n  \"confirmPassword\": \"Postman-Pass-2026\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status is 201\", () => pm.response.to.have.status(201));",
              "pm.test(\"HttpOnly auth cookie set\", () => { const c = pm.response.headers.find(h => h.key.toLowerCase() === \"set-cookie\"); pm.expect(c.value).to.match(/auth_token=.+HttpOnly/i); });",
              "pm.test(\"Token is NOT in the body\", () => pm.expect(pm.response.text()).to.not.include(\"eyJ\"));",
              "pm.test(\"No password hash in response\", () => pm.expect(pm.response.json().user).to.not.have.property(\"passwordHash\"));"
            ]
          }
        },
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const id = Date.now().toString(36);",
              "pm.collectionVariables.set(\"email\", `postman_${id}@example.com`);",
              "pm.collectionVariables.set(\"username\", `pm_${id}`);"
            ]
          }
        }
      ]
    },
    {
      "name": "Register \u2014 duplicate email \u2192 409",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/auth/register",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "auth",
            "register"
          ]
        },
        "description": "",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"{{email}}\",\n  \"username\": \"{{username}}_2\",\n  \"password\": \"Postman-Pass-2026\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status is 409\", () => pm.response.to.have.status(409));",
              "pm.test(\"email conflict\", () => pm.expect(pm.response.json().error.details[0].field).to.eql(\"email\"));"
            ]
          }
        }
      ]
    },
