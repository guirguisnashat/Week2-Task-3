          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "auth",
            "login"
          ]
        },
        "description": "",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"login\": \"{{username}}\",\n  \"password\": \"WrongPassword1\"\n}",
