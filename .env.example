# Copy this file to .env and fill in real values. Never commit .env.

# Secret used to sign JWTs. Must be long and random (at least 32 characters).
# Generate one with:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-me-with-a-long-random-string

# How long a login lasts, in seconds (default 7200 = 2 hours)
JWT_EXPIRES_IN_SECONDS=7200

# bcrypt cost factor (default 12). Higher = slower to brute-force, slower to log in.
BCRYPT_ROUNDS=12

PORT=3000
NODE_ENV=development
# DB_PATH=./data/auth.db
