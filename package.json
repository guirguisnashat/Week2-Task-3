{
  "name": "secure-auth-system",
  "version": "1.0.0",
  "description": "Authentication system with registration, bcrypt password hashing, JWT sessions in HttpOnly cookies, protected routes and logout (Node.js + Express + SQLite).",
  "main": "src/server.js",
  "type": "commonjs",
  "scripts": {
    "start": "node --env-file-if-exists=.env src/server.js",
    "dev": "node --env-file-if-exists=.env --watch src/server.js",
    "test": "node --test \"tests/**/*.test.js\""
  },
  "engines": {
    "node": ">=22"
  },
  "author": "Guirguis Nashat",
  "license": "MIT",
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "better-sqlite3": "^13.0.3",
    "cookie-parser": "^1.4.7",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.1",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3"
  }
}
